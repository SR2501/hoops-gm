# Copy to .env and fill in. Never commit the real file.

# --- Fantrax ---
# Found on your Fantrax profile page. Used by the official /fxea/ API.
FANTRAX_USER_SECRET_ID=
# Your league ID (from the league URL).
FANTRAX_LEAGUE_ID=
# Session cookie for private-league reads via fantraxapi.
# This is the bootstrap value only. The cookie is stored encrypted at
# data/fantrax_cookie.enc; see docs/adapters/fantrax-private.md.
FANTRAX_COOKIE=
# Fernet key encrypting that cookie at rest. This is the KEY, never the cookie.
# Keeping them in separate artefacts means neither alone is a credential.
# Generate with:
#   python -m hoops_gm.ingest.fantrax_private.cookies --generate-key
FANTRAX_COOKIE_KEY=

# --- Bridge ---
# Locally generated shared secret between the userscript and the backend.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_SECRET=

# --- Database ---
# ADR-001: SQLite in development, Postgres later. All access goes through
# SQLAlchemy, so switching is this line plus `alembic upgrade head`.
# A relative sqlite path is anchored to the repo root, not the working
# directory, so the database does not move depending on where you launched.
#   Postgres: postgresql+psycopg://hoops:hoops@127.0.0.1:5433/hoops_gm
DATABASE_URL=sqlite:///./hoops_gm.db
# Echo every statement to the log. Noisy; useful when a query is the suspect.
DATABASE_ECHO=false

# --- Server ---
# Local-first: do not bind to 0.0.0.0 without reading ADR-001.
# The one legitimate exception is inside a container, where the published port
# is bound to 127.0.0.1 on the host instead — see docker-compose.yml.
HOST=127.0.0.1
PORT=8000
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# console for a terminal, json under compose or anywhere logs are collected.
LOG_FORMAT=console
# Origins allowed to call the API. The dev server proxies /api and /health, so
# this matters only when the two are run on different origins.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Frontend (frontend/.env, read by Vite at build time) ---
# Where the dev server proxies /api and /health. Set to http://backend:8000
# under docker compose.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Absolute backend origin, for running the dashboard without the proxy. Leave
# unset in normal development.
# VITE_API_BASE_URL=

# --- Optional paid sources (owner-only decision to enable; see docs/governance/owner-decisions.md) ---
BALLDONTLIE_API_KEY=

# Copy to .env and fill in. Never commit the real file.

# --- Fantrax ---
# Found on your Fantrax profile page. Used by the official /fxea/ API.
FANTRAX_USER_SECRET_ID=
# Your league ID (from the league URL).
FANTRAX_LEAGUE_ID=
# Session cookie for private-league reads via fantraxapi.
# Stored encrypted at rest; this is the bootstrap value only.
FANTRAX_COOKIE=

# --- Bridge ---
# Locally generated shared secret between the userscript and the backend.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_SECRET=

# --- Database ---
DATABASE_URL=sqlite:///./hoops_gm.db

# --- Server ---
# Local-first: do not bind to 0.0.0.0 without reading ADR-001.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- Optional paid sources (owner-only decision to enable; see docs/governance/owner-decisions.md) ---
BALLDONTLIE_API_KEY=

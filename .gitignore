# Secrets — never commit real values
.env
.env.*
!.env.example
*.cookie
fantraxloggedin.cookie

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Databases
*.db
*.sqlite
*.sqlite3

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo
coverage/
npm-debug.log*
# package-lock.json is committed on purpose — `npm ci` in CI needs it.

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build artifacts
build/
*.egg
.tox/

# Local data — raw pulls and imports stay out of git
data/
*.csv
!docs/**/*.csv
!**/fixtures/**/*.csv

# Scratch live-evidence sampling directories (session-local, never committed)
.live_evidence*/
backend/.live_evidence*/

# Per-run test reports and the metrics derived from them. Generated by CI and
# by anyone running the suites locally; the baseline lives in the Actions cache
# rather than in git, precisely so a duration never arrives as a commit.
vitest-report.json
junit.xml
run-metrics/
metrics-baseline/
# Design-hook cache. Holds absolute paths and session IDs, so it is per-machine
# noise rather than shared configuration.
.impeccable/

# Raw private captures from a real Fantrax account. This repository is public,
# so an un-sanitized capture must fail closed rather than rely on memory. Narrow
# by design: the tracked adapter source lives in fantrax_private/ (underscore)
# and sanitized fixtures are named *_sanitized.json, so neither is shadowed.
# Limits worth knowing: this does not protect a file already tracked, and it is
# overridden by `git add -f`. It closes the accidental-copy path, not every path.
*.raw.json
fantrax-playoff-private/
